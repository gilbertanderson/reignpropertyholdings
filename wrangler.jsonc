{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reignpropertyholdings",
  "compatibility_date": "2026-08-29",
  // Pages Functions are compiled to ./dist/worker by `npm run build`; without
  // this the Worker deploy serves static assets only and every /apply/*,
  // /portal and /api/* request misses the Function that implements it.
  "main": "./dist/worker/index.js",
  "assets": {
    "directory": "./public"
  }
}
